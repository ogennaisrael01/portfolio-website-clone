---
import { siteConfig } from "../config";
---

<section id="hero" class="fade-up">
  <div class="hero-content">
    <div>
      <div class="hero-subtitle">
        {siteConfig.title}
      </div>
      <h1>{siteConfig.name}</h1>
    </div>

    <div class="hero-buttons">
      {
        siteConfig.social?.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            View GitHub
          </a>
        )
      }
      {
        siteConfig.social?.email && (
          <a href={`mailto:${siteConfig.social.email}`} class="btn btn-secondary">
            Get in Touch
          </a>
        )
      }
    </div>
  </div>
</section>