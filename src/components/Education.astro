---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="fade-up">
      <h2 class="section-title">Education</h2>
      <div class="section-subtitle-line"></div>

      <div class="education-grid">
        {siteConfig.education.map((edu) => (
          <div class="education-card fade-up">
            <h3 class="education-degree">{edu.degree}</h3>
            <p class="education-school">{edu.school}</p>
            <p class="education-date">{edu.dateRange}</p>

            <ul class="education-achievements">
              {edu.achievements.map((achievement) => (
                <li class="education-achievement">{achievement}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )
}
